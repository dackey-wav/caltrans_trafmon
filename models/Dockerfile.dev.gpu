# GPU shell. Torch comes from the base image; uv installs the rest into /opt/venv
# so the /workspace bind mount does not hide the environment.
FROM pytorch/pytorch:2.11.0-cuda13.0-cudnn9-runtime

WORKDIR /workspace

ENV PYTHONPATH=/workspace
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_COMPILE_BYTECODE=1
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:/root/.local/bin:${PATH}"
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh

COPY pyproject.toml uv.lock /workspace/
RUN uv venv --system-site-packages "$VIRTUAL_ENV" \
    && uv sync --frozen --group ml --no-install-project

COPY . /workspace

CMD ["bash"]
