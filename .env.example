CLICKHOUSE_DB=traffic
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Tools on the host use localhost. The GPU container overrides this to clickhouse.
DB_HOST=localhost
PORT=8123

# Mainline station beside CWWP2 camera C009 at Old Town, San Diego.
PEMS_STATION_ID=1108617
# Official PeMS 5-minute FTP feed requires a separate account from the website.
PEMS_SOURCE_MODE=ftp
PEMS_FTP_HOST=pems.dot.ca.gov
PEMS_FTP_USER=
PEMS_FTP_PASSWORD=
PEMS_FTP_TLS=1
PEMS_DISTRICT=11
# Alternative approved normalized HTTPS feed: set PEMS_SOURCE_MODE=https_csv.
PEMS_SOURCE_URL=
PEMS_HTTP_COOKIE=
PEMS_POLL_SECONDS=300
